# Copy to .env.deploy (git-ignored) and fill in. scripts/deploy.sh loads it automatically.
# AWS credentials come from your normal chain: AWS_PROFILE, SSO, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_PROFILE=
AWS_REGION=us-east-1

# Baked into the Lambda environment at deploy time
# AWS CodeCommit repo OpsPilot reads and opens fix PRs in (created by CoreStack, or imported if it exists)
CODECOMMIT_REPO=opspilot-aws
# Tickets go to AWS Systems Manager OpsCenter with the Lambda's IAM role: no URL, user or token needed.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Written into Secrets Manager after deploy (leave blank to skip)
SLACK_WEBHOOK_URL=
