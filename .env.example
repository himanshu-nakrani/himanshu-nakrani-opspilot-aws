AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
SCM_PROVIDER=codecommit
CODECOMMIT_REPO=opspilot-aws
CODECOMMIT_BRANCH=main
# Ticketing: AWS Systems Manager OpsCenter (IAM auth, nothing to configure)
TICKETING_PROVIDER=opscenter
OPSCENTER_SOURCE=OpsPilot
SLACK_WEBHOOK_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:opspilot/slack
NOTIFY_EMAIL=sre-team@example.com
RCA_MAX_TURNS=6
RCA_CONFIDENCE_THRESHOLD=0.6
DEDUP_WINDOW_MIN=15
